#!/bin/sh
':' //; rl_node="${RL_NODE:-node}"; case "$("$rl_node" -v 2>/dev/null)" in v2[0-9].*|v[3-9][0-9].*) ;; *) for rl_cand in /opt/homebrew/bin/node /usr/local/bin/node /home/linuxbrew/.linuxbrew/bin/node "$HOME/.volta/bin/node" "$HOME/.asdf/shims/node" "$HOME/.local/share/mise/shims/node" "$HOME"/.nvm/versions/node/v*/bin/node "$HOME"/.local/share/fnm/node-versions/v*/installation/bin/node "$HOME"/.fnm/node-versions/v*/installation/bin/node "$HOME"/.local/share/mise/installs/node/*/bin/node; do [ -x "$rl_cand" ] || continue; case "$("$rl_cand" -v 2>/dev/null)" in v2[0-9].*|v[3-9][0-9].*) rl_node="$rl_cand";; esac; done; case "$rl_node" in */*) PATH="${rl_node%/*}:$PATH"; export PATH;; esac;; esac; if [ -t 0 ] && [ -t 1 ]; then case " $* " in *" review "*) stty icanon echo isig icrnl 2>/dev/null; rl_review_tty=$(stty -g 2>/dev/null); trap 'test -z "$rl_review_tty" || stty "$rl_review_tty" 2>/dev/null' 0; trap 'exit 130' 2; trap 'exit 143' 15; trap 'exit 129' 1; "$rl_node" "$0" "$@"; exit "$?";; esac; fi; exec "$rl_node" "$0" "$@"
// The shell guard restores input after Node's exit-time tty reset. This line
// also remains valid JavaScript for callers that explicitly invoke node bin/rl.
const { runPublicCli } = await import("../dist/public-cli.js");
process.exitCode = await runPublicCli(process.argv.slice(2));
