{
  "name": "rl-workspaces",
  "version": "0.8.0",
  "description": "Manage Git worktrees, project notes, and Codex or Claude sessions from your terminal",
  "license": "MIT",
  "bin": {
    "rl": "bin/rl"
  },
  "files": [
    "bin/rl",
    "dist/**/*.js",
    "shell/rl.zsh",
    "config.example.toml"
  ],
  "os": [
    "darwin",
    "linux"
  ],
  "keywords": [
    "git",
    "worktree",
    "codex",
    "claude",
    "cli"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "pretest": "node -e \"fs.rmSync('.test-dist', { recursive: true, force: true })\"",
    "test": "npm run build && tsc -p tsconfig.test.json && node --test --test-concurrency=4 .test-dist/*.test.js && zsh -f tests/smoke.zsh",
    "test:package": "npm run build && tsc -p tsconfig.test.json && node --test .test-dist/package.test.js",
    "lint": "oxlint -c .oxlintrc.json src tests",
    "check": "npm run format:check && npm run lint && npm test",
    "verify": "npm run format && npm run lint && npm test",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"tsconfig*.json\" package.json",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"tsconfig*.json\" package.json"
  },
  "dependencies": {
    "proper-lockfile": "^4.1.2",
    "smol-toml": "^1.9.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/proper-lockfile": "^4.1.4",
    "oxlint": "^1.0.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bundleDependencies": [
    "proper-lockfile",
    "smol-toml",
    "zod"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Clemen-RosterLab/rl.git"
  },
  "homepage": "https://github.com/Clemen-RosterLab/rl#readme",
  "bugs": {
    "url": "https://github.com/Clemen-RosterLab/rl/issues"
  }
}
