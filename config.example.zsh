# Copy to ~/.config/rl/config.zsh (or use RL_CONFIG).
RL_REPO_ROOT="$HOME/Documents/GitHub/my-project"
RL_WORKTREE_DIR="$HOME/.rl/worktrees"
RL_REPO_NAME="my-project"
RL_DEFAULT_BASE="origin/main"
RL_STATE_DIR="$HOME/.rl/instances"
# Optional registered repository alias; rl --repo <alias> overrides this.
# Without it, RL selects by current worktree, then `rl repo use` default.
# RL_REPO="frontend"
